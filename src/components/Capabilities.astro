---
import { capabilities } from "../data/site";
import { accentText } from "../lib/accents";

const accentGlow = {
  primary: "bg-primary/10 group-hover:bg-primary/30",
  secondary: "bg-secondary/10 group-hover:bg-secondary/30",
  tertiary: "bg-tertiary/10 group-hover:bg-tertiary/30",
};
const accentShadow = {
  primary: "drop-shadow-[0_0_15px_rgba(124,92,255,0.5)]",
  secondary: "drop-shadow-[0_0_15px_rgba(34,211,238,0.5)]",
  tertiary: "drop-shadow-[0_0_15px_rgba(255,183,128,0.5)]",
};
---

<section
  id="capabilities"
  class="relative z-10 mx-auto max-w-(--container-screen) px-4 py-24 md:px-16"
>
  <div class="reveal mb-16 text-center md:text-left">
    <h2 class="text-4xl font-black tracking-tight text-heading md:text-5xl">
      What I Build
    </h2>
    <p class="mt-4 max-w-2xl text-lg font-light text-on-surface-variant">
      Specialized expertise across the modern AI-engineering stack.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      capabilities.map((c, i) => (
        <div
          class:list={[
            "glass-card glass-card-hover reveal group relative overflow-hidden rounded-3xl p-8 md:p-10",
            c.span,
          ]}
          style={`--reveal-delay:${i * 70}ms`}
        >
          <div
            class:list={[
              "absolute right-0 top-0 h-40 w-40 rounded-full blur-[50px] transition-colors duration-700",
              accentGlow[c.accent],
            ]}
          />
          {c.chips ? (
            <div class="flex flex-col items-start gap-8 md:flex-row md:items-center">
              <div class="flex-1">
                <span
                  class:list={[
                    "material-symbols-outlined filled mb-6 text-5xl",
                    accentText[c.accent],
                    accentShadow[c.accent],
                  ]}
                >
                  {c.icon}
                </span>
                <h3 class="mb-4 text-2xl font-bold tracking-tight text-heading">
                  {c.title}
                </h3>
                <p class="text-base font-light leading-relaxed text-on-surface-variant">
                  {c.body}
                </p>
              </div>
              <div class="flex flex-wrap gap-2 md:justify-end">
                {c.chips.map((chip) => (
                  <span class="tech-chip">{chip}</span>
                ))}
              </div>
            </div>
          ) : (
            <>
              <span
                class:list={[
                  "material-symbols-outlined filled mb-6 text-5xl",
                  accentText[c.accent],
                  accentShadow[c.accent],
                ]}
              >
                {c.icon}
              </span>
              <h3 class="mb-4 text-2xl font-bold tracking-tight text-heading">
                {c.title}
              </h3>
              <p class="text-base font-light leading-relaxed text-on-surface-variant">
                {c.body}
              </p>
            </>
          )}
        </div>
      ))
    }
  </div>
</section>
