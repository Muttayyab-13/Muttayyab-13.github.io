---
// Seven-layer Urdu → Roman Urdu transliteration pipeline.
// Colours come from theme tokens (--color-primary / --color-secondary and the
// fill-* utilities) so the diagram re-themes with the rest of the site rather
// than baking in brand hex codes.
//
// Laid out as two wrapped rows (4 + 3) rather than one 7-wide strip: at a
// single row the boxes shrink far below a readable type size on a 1280px page.
const stages = [
  { n: "01", title: "Whisper ASR", note: "Urdu speech → Urdu text" },
  { n: "02", title: "Loanword & Name Bypass", note: "1,041 words · 189 names" },
  { n: "03", title: "Normalization", note: "consistent model input" },
  { n: "04", title: "Fine-tuned M2M100", note: "Urdu → Roman Urdu" },
  { n: "05", title: "Reconstruction", note: "splice bypassed terms back" },
  { n: "06", title: "Fuzzy Correction", note: "repair near-miss spellings" },
  { n: "07", title: "Claude Haiku", note: "optional refinement pass" },
];

const COLS = 4;
const boxW = 236;
const boxH = 104;
const gapX = 34;
const gapY = 56;
const padX = 10;
const headY = 26; // baseline of the in/out rail labels

const row1Y = headY + 24;
const row2Y = row1Y + boxH + gapY;
const midY = row1Y + boxH + gapY / 2;

const width = padX * 2 + COLS * boxW + (COLS - 1) * gapX;
const height = row2Y + boxH + 60;

const colX = (c: number) => padX + c * (boxW + gapX);
const posOf = (i: number) => ({
  x: colX(i % COLS),
  y: i < COLS ? row1Y : row2Y,
});

const lastIndex = stages.length - 1;
// U-turn from the end of row 1 back to the start of row 2.
const wrapPath = `M ${colX(COLS - 1) + boxW / 2} ${row1Y + boxH} V ${midY} H ${
  colX(0) + boxW / 2
} V ${row2Y - 6}`;
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  class="h-auto w-full min-w-[680px]"
  role="img"
  aria-labelledby="romasub-pipeline-title romasub-pipeline-desc"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="romasub-pipeline-title">
    RomaSub.AI seven-layer transliteration pipeline
  </title>
  <desc id="romasub-pipeline-desc">
    Audio flows through Whisper ASR, a loanword and proper-noun bypass, text
    normalization, a fine-tuned M2M100 transliteration model, reconstruction of
    the bypassed terms, fuzzy correction, and an optional Claude Haiku
    refinement pass, producing time-aligned Roman Urdu captions.
  </desc>

  <defs>
    <linearGradient id="romasub-flow" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="var(--color-primary)"></stop>
      <stop offset="100%" stop-color="var(--color-secondary)"></stop>
    </linearGradient>
    <marker
      id="romasub-arrow"
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto-start-reverse"
    >
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--color-secondary)"></path>
    </marker>
  </defs>

  <!-- Rail labels -->
  <text
    x={padX + 2}
    y={headY}
    class="fill-on-surface-variant text-[12px] font-semibold uppercase tracking-[0.18em]"
  >
    Urdu audio in
  </text>
  <text
    x={width - padX - 2}
    y={height - 16}
    text-anchor="end"
    class="fill-on-surface-variant text-[12px] font-semibold uppercase tracking-[0.18em]"
  >
    Roman Urdu captions out
  </text>

  <!-- Row wrap connector -->
  <path
    d={wrapPath}
    stroke="var(--color-secondary)"
    stroke-width="1.5"
    stroke-linecap="round"
    opacity="0.55"
    marker-end="url(#romasub-arrow)"></path>

  {
    stages.map((s, i) => {
      const { x, y } = posOf(i);
      const optional = i === lastIndex;
      const sameRowPredecessor = i > 0 && i % COLS !== 0;
      return (
        <>
          {sameRowPredecessor && (
            <line
              x1={x - gapX + 4}
              y1={y + boxH / 2}
              x2={x - 7}
              y2={y + boxH / 2}
              stroke="url(#romasub-flow)"
              stroke-width="1.5"
              stroke-dasharray={optional ? "4 4" : undefined}
              marker-end="url(#romasub-arrow)"
            />
          )}

          <rect
            x={x}
            y={y}
            width={boxW}
            height={boxH}
            rx="14"
            class="fill-overlay/5 stroke-overlay/20"
            stroke-width="1"
            stroke-dasharray={optional ? "5 4" : undefined}
          />

          <text
            x={x + 18}
            y={y + 28}
            class="text-[12px] font-bold tabular-nums tracking-[0.14em]"
            fill="var(--color-primary)"
          >
            {s.n}
          </text>

          {optional && (
            <text
              x={x + boxW - 18}
              y={y + 28}
              text-anchor="end"
              class="fill-on-surface-variant text-[10px] font-semibold uppercase tracking-[0.14em]"
            >
              optional
            </text>
          )}

          <text
            x={x + 18}
            y={y + 58}
            class="fill-heading text-[14.5px] font-bold"
          >
            {s.title}
          </text>

          <text
            x={x + 18}
            y={y + 82}
            class="fill-on-surface-variant text-[12px] font-light"
          >
            {s.note}
          </text>
        </>
      );
    })
  }

  <!-- Fallback note -->
  <text
    x={padX + 2}
    y={height - 16}
    class="fill-on-surface-variant text-[12px] font-light"
  >
    Every layer has a defined fallback — a failure downgrades output quality
    instead of losing the caption.
  </text>
</svg>
