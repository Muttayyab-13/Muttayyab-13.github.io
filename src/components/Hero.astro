---
import { site, stats } from "../data/site";
import NeuralVisual from "./NeuralVisual.astro";
---

<section
  class="relative mx-auto flex min-h-[88vh] max-w-(--container-screen) flex-col justify-center px-4 py-24 md:px-16"
>
  <!-- Hero ambient glow -->
  <div
    class="pointer-events-none absolute left-1/4 top-1/2 -z-10 h-[600px] w-[600px] -translate-y-1/2 rounded-full bg-primary/20 blur-[120px]"
  >
  </div>

  <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
    <!-- Content -->
    <div class="order-2 space-y-10 lg:order-1 lg:col-span-6">
      <div class="space-y-6">
        <p
          class="reveal flex items-center gap-4 text-sm font-bold uppercase tracking-[0.2em] text-primary"
        >
          <span class="h-px w-12 bg-primary"></span>
          {site.role}
        </p>
        <h1
          class="reveal text-5xl font-black leading-[1.05] tracking-tighter text-white drop-shadow-2xl md:text-7xl lg:text-[84px]"
          style="--reveal-delay:80ms"
        >
          {site.hero.headlineLead}<br />
          <span class="text-gradient">{site.hero.headlineAccent}</span><br />
          {site.hero.headlineTail}
        </h1>
      </div>

      <p
        class="reveal max-w-xl text-lg font-light leading-relaxed text-on-surface-variant md:text-xl"
        style="--reveal-delay:160ms"
      >
        {site.hero.subline}
      </p>

      <div
        class="reveal flex flex-col gap-4 pt-2 sm:flex-row"
        style="--reveal-delay:240ms"
      >
        <a href="#work" class="btn-primary group">
          Explore Work
          <span
            class="material-symbols-outlined transition-transform group-hover:translate-x-1"
            >arrow_forward</span
          >
        </a>
        <a href="#capabilities" class="btn-ghost">View Capabilities</a>
      </div>
    </div>

    <!-- Visual -->
    <div class="order-1 lg:order-2 lg:col-span-6">
      <div
        class="glass-card glass-card-hover relative overflow-hidden rounded-3xl p-6"
      >
        <NeuralVisual />
      </div>
    </div>
  </div>

  <!-- Stats strip -->
  <div
    class="reveal mt-20 grid grid-cols-2 gap-8 border-t border-white/10 pt-12 md:grid-cols-4"
    style="--reveal-delay:120ms"
  >
    {
      stats.map((s) => (
        <div class="space-y-2">
          <div class="text-4xl font-black tracking-tight text-white md:text-5xl">
            {s.value}
          </div>
          <div class="text-sm font-semibold uppercase tracking-wider text-on-surface-variant">
            {s.label}
          </div>
        </div>
      ))
    }
  </div>
</section>
