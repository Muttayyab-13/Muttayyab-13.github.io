---
import { education, webBuilds, certifications } from "../data/site";
---

<section
  id="foundations"
  class="relative z-10 mx-auto max-w-(--container-screen) px-4 py-24 md:px-16"
>
  <div
    class="glass-card reveal relative overflow-hidden rounded-[40px] p-8 md:p-14"
  >
    <div
      class="pointer-events-none absolute right-0 top-0 h-full w-full bg-gradient-to-bl from-secondary/10 via-transparent to-transparent"
    >
    </div>

    <div class="relative z-10">
      <!-- ───────────── Education ───────────── -->
      <p class="section-eyebrow">Engineering Foundations</p>

      <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      >
        <div>
          <h2
            class="text-3xl font-black tracking-tight text-heading md:text-4xl"
          >
            {education.degree}
          </h2>
          <p class="mt-2 text-lg font-light text-on-surface-variant">
            {education.institution} · {education.campus}
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center gap-3">
          <span class="tech-chip">CGPA {education.cgpa}</span>
          <span
            class="text-sm font-medium tracking-wide text-on-surface-variant"
          >
            {education.start} – {education.end}
          </span>
        </div>
      </div>

      <p class="prose-body mt-6 max-w-3xl">{education.intro}</p>

      <!-- ───────────── Coursework as capabilities ───────────── -->
      <div class="mt-12 border-t border-overlay/10 pt-12">
        <h3
          class="text-sm font-bold uppercase tracking-[0.2em] text-secondary"
        >
          What the degree actually taught
        </h3>

        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            education.coursework.map((c, i) => (
              <div
                class="reveal rounded-2xl border border-overlay/10 bg-overlay/5 p-6 transition-colors duration-300 hover:border-overlay/25"
                style={`--reveal-delay:${i * 60}ms`}
              >
                <span
                  class="text-xs font-bold tabular-nums tracking-widest text-primary"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h4 class="mt-3 text-base font-bold tracking-tight text-heading">
                  {c.title}
                </h4>
                <p class="mt-2 text-sm font-light leading-relaxed text-on-surface-variant">
                  {c.body}
                </p>
              </div>
            ))
          }
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          {
            education.supporting.map((s) => (
              <span class="tech-chip bg-background/50">{s}</span>
            ))
          }
        </div>
      </div>

      <!-- ───────────── Web & full-stack builds ───────────── -->
      <div class="mt-12 border-t border-overlay/10 pt-12">
        <h3 class="text-sm font-bold uppercase tracking-[0.2em] text-tertiary">
          Web &amp; Full-Stack Builds
        </h3>
        <p class="mt-3 max-w-3xl text-base font-light text-on-surface-variant">
          Before the AI work — and alongside it — shipping conventional
          full-stack products end to end.
        </p>

        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {
            webBuilds.map((b, i) => (
              <div
                class="reveal rounded-2xl border border-overlay/10 bg-overlay/5 p-6"
                style={`--reveal-delay:${i * 60}ms`}
              >
                <h4 class="text-base font-bold tracking-tight text-heading">
                  {b.title}
                </h4>
                <p class="mt-2 text-sm font-light leading-relaxed text-on-surface-variant">
                  {b.body}
                </p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {b.stack.map((t) => (
                    <span class="tech-chip bg-background/50 text-[11px]">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- ───────────── Certifications ───────────── -->
      <div class="mt-12 border-t border-overlay/10 pt-12">
        <h3 class="text-sm font-bold uppercase tracking-[0.2em] text-primary">
          Certifications
        </h3>

        <div class="mt-8 grid gap-5 md:grid-cols-2">
          {
            certifications.map((c, i) => (
              <div
                class="reveal rounded-2xl border border-overlay/10 bg-overlay/5 p-6"
                style={`--reveal-delay:${i * 60}ms`}
              >
                <h4 class="text-base font-bold tracking-tight text-heading">
                  {c.title}
                </h4>
                <p class="mt-1 text-sm font-medium text-secondary">
                  {c.issuer}
                  <span class="font-normal text-on-surface-variant">
                    {" · "}{c.period}
                  </span>
                </p>
                <p class="mt-3 text-sm font-light leading-relaxed text-on-surface-variant">
                  {c.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
