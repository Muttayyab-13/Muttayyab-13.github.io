---
import { projects } from "../data/site";
import { accentText } from "../lib/accents";

const accentBox = {
  primary: "bg-primary/10 border-primary/20",
  secondary: "bg-secondary/10 border-secondary/20",
  tertiary: "bg-tertiary/10 border-tertiary/20",
};
const accentShadow = {
  primary: "drop-shadow-[0_0_10px_rgba(124,92,255,0.5)]",
  secondary: "drop-shadow-[0_0_10px_rgba(34,211,238,0.5)]",
  tertiary: "drop-shadow-[0_0_10px_rgba(255,183,128,0.5)]",
};

const featured = projects.find((p) => p.size === "featured");
const talls = projects.filter((p) => p.size === "tall");
const smalls = projects.filter((p) => p.size === "small");
---

<section
  id="work"
  class="relative z-10 mx-auto max-w-(--container-screen) overflow-x-clip px-4 py-24 md:px-16"
>
  <div
    class="pointer-events-none absolute right-0 top-1/2 -z-10 h-[500px] w-[500px] rounded-full bg-secondary/10 blur-[150px]"
  >
  </div>

  <div class="reveal mb-16">
    <h2 class="text-4xl font-black tracking-tight text-heading md:text-5xl">
      Selected Work
    </h2>
  </div>

  <div
    class="grid auto-rows-[minmax(280px,auto)] grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4"
  >
    <!-- Featured -->
    {
      featured && (
        <div class="glass-card glass-card-hover reveal group relative flex flex-col overflow-hidden rounded-3xl md:col-span-2 md:row-span-2">
          <div class="absolute inset-0 z-0 bg-gradient-to-br from-primary/20 to-secondary/20 opacity-50 transition-opacity duration-700 group-hover:opacity-80" />
          <div class="relative z-10 h-[250px] w-full overflow-hidden p-6 md:h-1/2">
            <div class="relative flex h-full w-full items-center justify-center overflow-hidden rounded-2xl border border-overlay/10 bg-background/40 backdrop-blur-md transition-colors duration-500 group-hover:border-overlay/30">
              <span class="material-symbols-outlined text-7xl text-primary drop-shadow-[0_0_20px_rgba(124,92,255,0.8)] transition-transform duration-700 group-hover:scale-110">
                {featured.icon}
              </span>
            </div>
          </div>
          <div class="z-10 flex flex-1 flex-col justify-end bg-gradient-to-t from-background to-transparent p-8 md:p-10">
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tech-chip border-primary/30 bg-gradient-to-r from-primary/20 to-secondary/20 font-bold text-heading">
                Featured
              </span>
              {featured.tags.map((t) => (
                <span class="tech-chip">{t}</span>
              ))}
            </div>
            <h3 class="mb-4 text-3xl font-bold tracking-tight text-heading md:text-4xl">
              {featured.title}
            </h3>
            <p class="mb-8 text-lg font-light leading-relaxed text-on-surface-variant">
              {featured.body}
            </p>
            <a
              href={featured.href}
              class="group/btn inline-flex w-fit items-center text-sm font-bold uppercase tracking-widest text-primary transition-colors hover:text-secondary"
            >
              Explore Case Study
              <span class="material-symbols-outlined ml-2 text-lg transition-transform group-hover/btn:translate-x-2">
                arrow_forward
              </span>
            </a>
          </div>
        </div>
      )
    }

    <!-- Tall -->
    {
      talls.map((tall, i) => (
        <div
          class="glass-card glass-card-hover reveal group relative flex flex-col overflow-hidden rounded-3xl p-8 md:row-span-2 md:p-10"
          style={`--reveal-delay:${i * 80}ms`}
        >
          <div class="absolute inset-0 z-0 bg-gradient-to-b from-secondary/10 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
          <div class="z-10 flex h-full flex-1 flex-col">
            <div class="mb-8 flex items-start justify-between">
              <div
                class:list={[
                  "flex h-14 w-14 items-center justify-center rounded-2xl border",
                  accentBox[tall.accent],
                ]}
              >
                <span
                  class:list={[
                    "material-symbols-outlined text-3xl",
                    accentText[tall.accent],
                    accentShadow[tall.accent],
                  ]}
                >
                  {tall.icon}
                </span>
              </div>
            </div>
            <div class="mt-auto">
              <h3 class="mb-4 text-2xl font-bold tracking-tight text-heading">
                {tall.title}
              </h3>
              <p class="mb-6 text-base font-light leading-relaxed text-on-surface-variant">
                {tall.body}
              </p>
              {tall.tags.length > 0 && (
                <div class="mb-8 flex flex-wrap gap-2">
                  {tall.tags.map((t) => (
                    <span class="tech-chip bg-background/50">{t}</span>
                  ))}
                </div>
              )}
              <a
                href={tall.href}
                class="group/btn inline-flex w-fit items-center text-sm font-medium uppercase tracking-wider text-heading transition-colors hover:text-secondary"
              >
                Details
                <span class="material-symbols-outlined ml-2 text-base transition-transform group-hover/btn:translate-x-1">
                  arrow_forward
                </span>
              </a>
            </div>
          </div>
        </div>
      ))
    }

    <!-- Small cards -->
    {
      smalls.map((p, i) => (
        <div
          class="glass-card glass-card-hover reveal group relative flex flex-col overflow-hidden rounded-3xl p-8"
          style={`--reveal-delay:${i * 80}ms`}
        >
          <div class="z-10 flex flex-1 flex-col">
            <div
              class:list={[
                "mb-6 flex h-12 w-12 items-center justify-center rounded-xl border",
                accentBox[p.accent],
              ]}
            >
              <span
                class:list={[
                  "material-symbols-outlined text-2xl",
                  accentText[p.accent],
                  accentShadow[p.accent],
                ]}
              >
                {p.icon}
              </span>
            </div>
            <h3 class="mb-3 text-xl font-bold tracking-tight text-heading">
              {p.title}
            </h3>
            <p class="mb-5 text-sm font-light text-on-surface-variant">
              {p.body}
            </p>
            {p.tags.length > 0 && (
              <div class="mb-6 flex flex-wrap gap-2">
                {p.tags.map((t) => (
                  <span class="tech-chip bg-background/50 text-[11px]">{t}</span>
                ))}
              </div>
            )}
            <a
              href={p.href}
              class="group/btn mt-auto inline-flex w-fit items-center text-xs font-medium uppercase tracking-wider text-heading transition-colors hover:text-primary"
            >
              View
              <span class="material-symbols-outlined ml-1 text-sm transition-transform group-hover/btn:translate-x-1">
                arrow_forward
              </span>
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>
