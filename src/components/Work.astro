---
import { projects } from "../data/site";
import { accentText } from "../lib/accents";

const accentBox = {
  primary: "bg-primary/10 border-primary/20",
  secondary: "bg-secondary/10 border-secondary/20",
  tertiary: "bg-tertiary/10 border-tertiary/20",
};
const accentShadow = {
  primary: "drop-shadow-[0_0_10px_rgba(124,92,255,0.5)]",
  secondary: "drop-shadow-[0_0_10px_rgba(34,211,238,0.5)]",
  tertiary: "drop-shadow-[0_0_10px_rgba(255,183,128,0.5)]",
};

const featured = projects.find((p) => p.size === "featured");
const talls = projects.filter((p) => p.size === "tall");
const smalls = projects.filter((p) => p.size === "small");

// Headline metrics for the featured card's visual area. The project is private,
// so there are no screenshots — the outcome fills the space instead.
const featuredResults = featured?.caseStudy?.results.slice(0, 3) ?? [];

// Every card is one link covering its whole surface (see .card-link in
// global.css). One tab stop per card, one consistent label.
const CARD =
  "card-surface glass-card glass-card-hover reveal group relative flex flex-col overflow-hidden rounded-3xl";
---

<section
  id="work"
  class="relative z-10 mx-auto max-w-(--container-screen) overflow-x-clip px-4 py-24 md:px-16"
>
  <div
    class="pointer-events-none absolute right-0 top-1/2 -z-10 h-[500px] w-[500px] rounded-full bg-secondary/10 blur-[150px]"
  >
  </div>

  <div class="reveal mb-6">
    <h2 class="text-4xl font-black tracking-tight text-heading md:text-5xl">
      Selected Work
    </h2>
    <p class="mt-4 max-w-2xl text-lg font-light text-on-surface-variant">
      Five projects, each with a full write-up — the problem, the architecture,
      what broke, and what it produced.
    </p>
  </div>

  <div
    class="mb-12 flex items-center gap-2 text-sm font-medium text-on-surface-variant"
  >
    <span class="material-symbols-outlined text-base text-primary"
      >touch_app</span
    >
    Every card opens a case study
  </div>

  <div
    class="grid auto-rows-[minmax(280px,auto)] grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4"
  >
    <!-- Featured -->
    {
      featured && (
        <article class={`${CARD} md:col-span-2 md:row-span-2`}>
          <div class="absolute inset-0 z-0 bg-gradient-to-br from-primary/20 to-secondary/20 opacity-50 transition-opacity duration-700 group-hover:opacity-80" />

          {/* Visual area: large mark + the outcome, since this project is private */}
          <div class="relative z-10 h-[250px] w-full shrink-0 overflow-hidden p-6 md:h-[280px]">
            <div class="relative flex h-full w-full flex-col items-center justify-center gap-7 overflow-hidden rounded-2xl border border-overlay/10 bg-background/40 px-6 backdrop-blur-md transition-colors duration-500 group-hover:border-overlay/30">
              <span class="material-symbols-outlined text-[92px] leading-none text-primary drop-shadow-[0_0_28px_rgba(124,92,255,0.75)] transition-transform duration-700 group-hover:scale-110">
                {featured.icon}
              </span>

              {featuredResults.length > 0 && (
                <div class="grid w-full max-w-lg grid-cols-3 gap-4 border-t border-overlay/10 pt-5">
                  {featuredResults.map((r) => (
                    <div class="text-center">
                      <div class="text-base font-black tracking-tight text-heading md:text-lg">
                        {r.value}
                      </div>
                      <div class="mt-1 text-[10px] font-semibold uppercase leading-tight tracking-wider text-on-surface-variant">
                        {r.label}
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div class="z-10 flex flex-1 flex-col justify-end bg-gradient-to-t from-background to-transparent p-8 md:p-10">
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tech-chip border-primary/30 bg-gradient-to-r from-primary/20 to-secondary/20 font-bold text-heading">
                Featured
              </span>
              {featured.tags.map((t) => (
                <span class="tech-chip">{t}</span>
              ))}
            </div>
            <h3 class="mb-4 text-3xl font-bold tracking-tight text-heading md:text-4xl">
              {featured.title}
            </h3>
            <p class="mb-8 text-lg font-light leading-relaxed text-on-surface-variant">
              {featured.body}
            </p>
            <a
              href={featured.href}
              aria-label={`View case study: ${featured.title}`}
              class="card-link group/btn inline-flex w-fit items-center text-sm font-bold uppercase tracking-widest text-primary transition-colors hover:text-secondary"
            >
              View case study
              <span class="material-symbols-outlined ml-2 text-lg transition-transform group-hover:translate-x-2">
                arrow_forward
              </span>
            </a>
          </div>
        </article>
      )
    }

    <!-- Tall -->
    {
      talls.map((p, i) => (
        <article
          class={`${CARD} p-8 md:row-span-2 md:p-10`}
          style={`--reveal-delay:${i * 80}ms`}
        >
          <div class="absolute inset-0 z-0 bg-gradient-to-b from-secondary/10 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
          <div class="z-10 flex h-full flex-1 flex-col">
            <div class="mb-8 flex items-start justify-between">
              <div
                class:list={[
                  "flex h-14 w-14 items-center justify-center rounded-2xl border",
                  accentBox[p.accent],
                ]}
              >
                <span
                  class:list={[
                    "material-symbols-outlined text-3xl",
                    accentText[p.accent],
                    accentShadow[p.accent],
                  ]}
                >
                  {p.icon}
                </span>
              </div>
            </div>
            <div class="mt-auto">
              <h3 class="mb-4 text-2xl font-bold tracking-tight text-heading">
                {p.title}
              </h3>
              <p class="mb-6 text-base font-light leading-relaxed text-on-surface-variant">
                {p.body}
              </p>
              {p.tags.length > 0 && (
                <div class="mb-8 flex flex-wrap gap-2">
                  {p.tags.map((t) => (
                    <span class="tech-chip bg-background/50">{t}</span>
                  ))}
                </div>
              )}
              <a
                href={p.href}
                aria-label={`View case study: ${p.title}`}
                class="card-link group/btn inline-flex w-fit items-center text-sm font-bold uppercase tracking-wider text-primary transition-colors hover:text-secondary"
              >
                View case study
                <span class="material-symbols-outlined ml-2 text-base transition-transform group-hover:translate-x-1">
                  arrow_forward
                </span>
              </a>
            </div>
          </div>
        </article>
      ))
    }

    <!-- Small: two per row on wide screens so the row never half-fills -->
    {
      smalls.map((p, i) => (
        <article
          class={`${CARD} p-8 lg:col-span-2`}
          style={`--reveal-delay:${i * 80}ms`}
        >
          <div class="z-10 flex flex-1 flex-col">
            <div
              class:list={[
                "mb-6 flex h-12 w-12 items-center justify-center rounded-xl border",
                accentBox[p.accent],
              ]}
            >
              <span
                class:list={[
                  "material-symbols-outlined text-2xl",
                  accentText[p.accent],
                  accentShadow[p.accent],
                ]}
              >
                {p.icon}
              </span>
            </div>
            <h3 class="mb-3 text-xl font-bold tracking-tight text-heading">
              {p.title}
            </h3>
            <p class="mb-5 text-base font-light leading-relaxed text-on-surface-variant">
              {p.body}
            </p>
            {p.tags.length > 0 && (
              <div class="mb-6 flex flex-wrap gap-2">
                {p.tags.map((t) => (
                  <span class="tech-chip bg-background/50">{t}</span>
                ))}
              </div>
            )}
            <a
              href={p.href}
              aria-label={`View case study: ${p.title}`}
              class="card-link group/btn mt-auto inline-flex w-fit items-center text-sm font-bold uppercase tracking-wider text-primary transition-colors hover:text-secondary"
            >
              View case study
              <span class="material-symbols-outlined ml-1 text-base transition-transform group-hover:translate-x-1">
                arrow_forward
              </span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
