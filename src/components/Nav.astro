---
import { site, navLinks } from "../data/site";
---

<nav
  class="fixed top-0 z-50 w-full border-b border-overlay/5 bg-background/80 shadow-xl backdrop-blur-xl"
>
  <div
    class="mx-auto flex max-w-(--container-screen) items-center justify-between px-4 py-3 md:px-16"
  >
    <!-- Personal brand lockup: monogram + name + live status -->
    <a href="#" class="group flex items-center gap-3">
      <span class="relative shrink-0">
        <span
          class="flex h-11 w-11 items-center justify-center rounded-xl border border-overlay/15 bg-gradient-to-br from-primary/40 to-secondary/25 text-base font-black tracking-tight text-white shadow-[0_0_22px_rgba(124,92,255,0.4)] backdrop-blur transition-transform duration-300 group-hover:scale-105"
        >
          {site.initials}
        </span>
        {
          site.available && (
            <span class="absolute -bottom-0.5 -right-0.5 flex h-3.5 w-3.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75" />
              <span class="relative inline-flex h-3.5 w-3.5 rounded-full border-2 border-background bg-emerald-400" />
            </span>
          )
        }
      </span>
      <span class="flex flex-col leading-tight">
        <span
          class="text-sm font-bold tracking-tight text-heading md:text-base"
        >
          {site.name}
        </span>
        <span
          class="hidden text-[11px] font-medium uppercase tracking-[0.18em] text-on-surface-variant sm:block"
        >
          {site.navTagline}
        </span>
      </span>
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-6 lg:flex xl:gap-8">
      {
        navLinks.map((link, i) => (
          <a
            href={link.href}
            class:list={[
              "text-sm tracking-wide transition-colors duration-300 hover:text-secondary",
              i === 0 ? "font-bold text-primary" : "text-on-surface-variant",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Right controls: theme toggle (always visible), Hire Me (desktop), menu (mobile) -->
    <div class="flex items-center gap-2 md:gap-4">
      <button
        data-theme-toggle
        type="button"
        aria-label="Switch to light theme"
        aria-pressed="false"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-overlay/15 bg-overlay/5 text-on-surface transition-colors duration-300 hover:bg-overlay/10 hover:text-heading"
      >
        <span class="material-symbols-outlined text-[20px]" data-theme-icon>
          light_mode
        </span>
      </button>

      <a
        href={site.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-1.5 rounded-full border border-overlay/15 bg-overlay/5 px-5 py-2 text-sm font-medium text-on-surface transition-all duration-300 hover:bg-overlay/10 hover:text-heading lg:inline-flex"
      >
        <span class="material-symbols-outlined text-[18px]">download</span>
        Resume
      </a>

      <a
        href="/#contact"
        class="hidden rounded-full border border-overlay/20 bg-overlay/10 px-6 py-2 text-sm font-medium text-heading transition-all duration-300 hover:bg-overlay/20 lg:inline-flex"
      >
        Hire Me
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        class="text-on-surface lg:hidden"
      >
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-overlay/5 bg-background/95 px-4 py-4 backdrop-blur-xl lg:hidden"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-lg px-3 py-3 text-base text-on-surface-variant transition-colors hover:bg-overlay/5 hover:text-heading"
          data-mobile-link
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={site.resumeUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-mobile-link
      class="mt-2 flex items-center justify-center gap-1.5 rounded-full border border-overlay/15 bg-overlay/5 px-6 py-3 text-center text-sm font-medium text-on-surface"
    >
      <span class="material-symbols-outlined text-[18px]">download</span>
      Resume
    </a>
    <a
      href="/#contact"
      data-mobile-link
      class="rounded-full border border-overlay/20 bg-overlay/10 px-6 py-3 text-center text-sm font-medium text-heading"
    >
      Hire Me
    </a>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const icon = toggle?.querySelector(".material-symbols-outlined");

  function close() {
    menu?.classList.add("hidden");
    menu?.classList.remove("flex");
    toggle?.setAttribute("aria-expanded", "false");
    if (icon) icon.textContent = "menu";
  }

  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    menu?.classList.toggle("flex", open);
    toggle?.setAttribute("aria-expanded", String(open));
    if (icon) icon.textContent = open ? "close" : "menu";
  });

  document
    .querySelectorAll("[data-mobile-link]")
    .forEach((l) => l.addEventListener("click", close));
</script>
