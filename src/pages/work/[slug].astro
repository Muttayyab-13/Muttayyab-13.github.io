---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { site, caseStudies } from "../../data/site";

export function getStaticPaths() {
  return caseStudies.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const cs = project.caseStudy!;
const pageTitle = `${project.title} — Case Study · ${site.name}`;
const pageDescription = cs.tagline;
---

<Base title={pageTitle} description={pageDescription}>
  <Nav />
  <main class="relative z-10 pt-[96px]">
    <article
      class="mx-auto max-w-(--container-screen) px-4 pb-24 md:px-16"
    >
      <!-- Ambient glow -->
      <div
        class="pointer-events-none absolute left-1/4 top-24 -z-10 h-[420px] w-[420px] -translate-x-1/2 rounded-full blur-[140px]"
        style="background-color:var(--glow-1)"
      >
      </div>

      <!-- ───────────── Header ───────────── -->
      <header class="reveal max-w-3xl pt-12 md:pt-16">
        <a
          href="/#work"
          class="group inline-flex items-center gap-1.5 text-sm font-medium text-on-surface-variant transition-colors hover:text-heading"
        >
          <span
            class="material-symbols-outlined text-base transition-transform group-hover:-translate-x-1"
            >arrow_back</span
          >
          All work
        </a>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <span
            class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.2em] text-primary"
          >
            <span class="h-px w-8 bg-primary"></span>
            Case Study
          </span>
          {
            cs.isPrivate && (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-overlay/15 bg-overlay/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-on-surface-variant">
                <span class="material-symbols-outlined text-sm">lock</span>
                Private project
              </span>
            )
          }
        </div>

        <h1
          class="mt-5 text-4xl font-black leading-[1.05] tracking-tight text-heading md:text-6xl"
        >
          {project.title}
        </h1>
        <p
          class="mt-6 text-lg font-light leading-relaxed text-on-surface-variant md:text-xl"
        >
          {cs.tagline}
        </p>

        <div class="mt-8 flex flex-wrap gap-2">
          {project.tags.map((t) => <span class="tech-chip">{t}</span>)}
        </div>
      </header>

      <!-- ───────────── Problem / Role ───────────── -->
      <section class="reveal mt-20 grid gap-12 md:mt-28 md:grid-cols-2">
        <div>
          <h2 class="section-eyebrow">The Problem</h2>
          <p class="prose-body">{cs.problem}</p>
        </div>
        <div>
          <h2 class="section-eyebrow">My Role</h2>
          <p class="prose-body">{cs.role}</p>
        </div>
      </section>

      <!-- ───────────── Architecture ───────────── -->
      <section class="reveal mt-20 md:mt-28">
        <h2 class="text-3xl font-black tracking-tight text-heading md:text-4xl">
          Architecture
        </h2>
        <p class="prose-body mt-4 max-w-3xl">{cs.architecture.intro}</p>

        <ol class="mt-12 space-y-4">
          {
            cs.architecture.steps.map((step, i) => (
              <li class="glass-card flex gap-5 rounded-2xl p-6 md:p-7">
                <span
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-primary/30 bg-gradient-to-br from-primary/25 to-secondary/20 text-base font-black text-heading"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3 class="text-lg font-bold tracking-tight text-heading">
                    {step.title}
                  </h3>
                  <p class="mt-1.5 text-base font-light leading-relaxed text-on-surface-variant">
                    {step.body}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- ───────────── Tech Stack ───────────── -->
      <section class="reveal mt-20 md:mt-28">
        <h2 class="text-3xl font-black tracking-tight text-heading md:text-4xl">
          Tech Stack
        </h2>
        <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            cs.techStack.map((group) => (
              <div class="glass-card rounded-2xl p-6">
                <h3 class="text-xs font-bold uppercase tracking-[0.18em] text-primary">
                  {group.group}
                </h3>
                <div class="mt-4 flex flex-wrap gap-2">
                  {group.items.map((item) => (
                    <span class="tech-chip">{item}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ───────────── Key Features ───────────── -->
      <section class="reveal mt-20 md:mt-28">
        <h2 class="text-3xl font-black tracking-tight text-heading md:text-4xl">
          Key Features
        </h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {
            cs.features.map((f) => (
              <div class="glass-card glass-card-hover group rounded-2xl p-7">
                <span class="material-symbols-outlined filled text-3xl text-secondary drop-shadow-[0_0_12px_rgba(34,211,238,0.5)]">
                  {f.icon}
                </span>
                <h3 class="mt-4 text-xl font-bold tracking-tight text-heading">
                  {f.title}
                </h3>
                <p class="mt-2 text-base font-light leading-relaxed text-on-surface-variant">
                  {f.body}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ───────────── Results ───────────── -->
      <section class="reveal mt-20 md:mt-28">
        <h2 class="text-3xl font-black tracking-tight text-heading md:text-4xl">
          Results
        </h2>
        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
          {
            cs.results.map((r) => (
              <div class="glass-card rounded-2xl p-8 text-center">
                <div class="text-3xl font-black tracking-tight text-gradient md:text-4xl">
                  {r.value}
                </div>
                <div class="mt-3 text-sm font-semibold uppercase tracking-wider text-on-surface-variant">
                  {r.label}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ───────────── Challenges ───────────── -->
      <section class="reveal mt-20 md:mt-28">
        <h2 class="text-3xl font-black tracking-tight text-heading md:text-4xl">
          Challenges
        </h2>
        <div class="mt-8 space-y-4">
          {
            cs.challenges.map((c) => (
              <div class="glass-card rounded-2xl p-6 md:p-7">
                <h3 class="flex items-center gap-2.5 text-lg font-bold tracking-tight text-heading">
                  <span class="material-symbols-outlined text-tertiary">
                    bolt
                  </span>
                  {c.title}
                </h3>
                <p class="mt-2 text-base font-light leading-relaxed text-on-surface-variant">
                  {c.body}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ───────────── Screenshots ───────────── -->
      <section class="reveal mt-20 md:mt-28">
        <h2 class="text-3xl font-black tracking-tight text-heading md:text-4xl">
          Screenshots
        </h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {
            cs.screenshots.map((shot) =>
              shot.src ? (
                <figure class="glass-card overflow-hidden rounded-2xl">
                  <img
                    src={shot.src}
                    alt={shot.caption}
                    loading="lazy"
                    class="aspect-video w-full object-cover"
                  />
                  <figcaption class="px-5 py-3 text-sm text-on-surface-variant">
                    {shot.caption}
                  </figcaption>
                </figure>
              ) : (
                <figure class="glass-card overflow-hidden rounded-2xl">
                  <div class="flex aspect-video w-full flex-col items-center justify-center gap-2 border-b border-dashed border-overlay/15 bg-overlay/5 text-on-surface-variant">
                    <span class="material-symbols-outlined text-4xl opacity-60">
                      image
                    </span>
                    <span class="text-xs uppercase tracking-wider opacity-70">
                      Screenshot coming soon
                    </span>
                  </div>
                  <figcaption class="px-5 py-3 text-sm text-on-surface-variant">
                    {shot.caption}
                  </figcaption>
                </figure>
              ),
            )
          }
        </div>
      </section>

      <!-- ───────────── Bottom CTA ───────────── -->
      <section
        class="glass-card reveal relative mt-24 overflow-hidden rounded-[32px] px-8 py-14 text-center md:mt-32 md:px-16"
      >
        <div
          class="pointer-events-none absolute -top-1/2 left-1/2 h-[300px] w-[300px] -translate-x-1/2 rounded-full blur-[120px]"
          style="background-color:var(--glow-1)"
        >
        </div>
        <h2 class="relative z-10 text-3xl font-black tracking-tight text-heading md:text-4xl">
          Interested in <span class="text-gradient">document-AI</span> work?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base font-light text-on-surface-variant">
          I build pipelines like this end to end. Let's talk about yours.
        </p>
        <div
          class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row"
        >
          <a href="/#contact" class="btn-primary">
            Get in touch
            <span class="material-symbols-outlined">arrow_outward</span>
          </a>
          <a href="/#work" class="btn-ghost">
            <span class="material-symbols-outlined">arrow_back</span>
            All work
          </a>
        </div>
      </section>
    </article>
  </main>
  <Footer />
</Base>
